{
    "name": "devnullius/yii2-sentry",
    "description": "Yii2 integration for Sentry",
    "keywords": [
        "logging",
        "errors",
        "yii2",
        "sentry",
        "v2",
        "sdk"
    ],
    "type": "library",
    "license": "BSD-3-Clause",
    "minimum-stability": "stable",
    "support": {
        "issues": "https://github.com/devnullius/yii2-sentry/issues",
        "source": "https://github.com/devnullius/yii2-sentry"
    },
    "authors": [
        {
            "name": "Oleg Tsvetkov",
            "email": "me@olegtsvetkov.com",
            "homepage": "https://olegtsvetkov.com/",
            "role": "Creator"
        },
        {
            "name": "Sergei Iamskoi",
            "email": "syamskoy@gmail.com",
            "homepage": "https://iamskoi.com/",
            "role": "Improver"
        },
        {
            "name": "Aram Harutyunyan",
            "email": "aram.ds@gmail.com",
            "homepage": "https://ctrlf5.io/",
            "role": "Improver"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": false
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "sentry/sentry": "^4.33",
        "yiisoft/yii2": "^2.0.55"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6.38",
        "yiisoft/yii2-httpclient": "^2.0.15"
    },
    "suggest": {
        "yiisoft/yii2-httpclient": "Records outgoing yii2-httpclient requests when performance tracing is enabled"
    },
    "autoload": {
        "psr-4": {
            "devnullius\\yii2\\sentry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "devnullius\\yii2\\sentry\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}

<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheResult="false"
         convertDeprecationsToExceptions="false"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <!-- In-process tests: Yii applications built inside PHPUnit, each test in its own process. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- End-to-end tests: a real Yii web app served by PHP's built-in server (SAPI cli-server). -->
        <testsuite name="Web">
            <directory>tests/Web</directory>
        </testsuite>
    </testsuites>
</phpunit>

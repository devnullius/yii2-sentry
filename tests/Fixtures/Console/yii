<?php

declare(strict_types=1);

// Console entry script for the queue worker tests (tests/Worker): a real yii2-queue worker, and the child process it
// starts for each job with this same script. Every process records what the SDK would send to the file named by
// SENTRY_TEST_OUT_FILE.

// Like php.ini-production: deprecations are not reported.
error_reporting(E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED);
// Unlike php.ini-production, like PHP without a php.ini (e.g. in Docker images): stack traces hold the arguments of
// every call, which must not carry a job's data to Sentry.
ini_set('zend.exception_ignore_args', '0');

define('YII_DEBUG', false);
define('YII_ENV', 'prod');

require dirname(__DIR__, 3) . '/vendor/autoload.php';
require dirname(__DIR__, 3) . '/vendor/yiisoft/yii2/Yii.php';

$config = require __DIR__ . '/config.php';

$application = new yii\console\Application($config(
    (string)(getenv('SENTRY_TEST_SCENARIO') ?: 'default'),
    (string)getenv('SENTRY_TEST_OUT_FILE'),
    (string)getenv('SENTRY_TEST_QUEUE_PATH')
));

exit($application->run());
